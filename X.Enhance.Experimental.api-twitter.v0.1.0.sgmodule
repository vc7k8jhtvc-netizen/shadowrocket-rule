#!name=X Enhance Experimental (api.twitter.com)
#!version=0.1.0
#!desc=实验模块：尝试 MITM api.twitter.com，并把 GraphQL 请求中的 includePromotedContent 强制改为 false；若 X 首页空白/网络错误，请立即停用本模块
#!author=vc7k8jhtvc-netizen
#!homepage=https://github.com/vc7k8jhtvc-netizen/shadowrocket-rule
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Twitter.png

[Script]
# 请求阶段：只修改 GraphQL variables 里的 includePromotedContent，不改认证头、Cookie 或 Host
x.experimental.request = type=http-request,pattern=^https:\/\/api\.twitter\.com\/(?:i\/api\/)?graphql\/,requires-body=1,max-size=1048576,timeout=8,script-path=https://raw.githubusercontent.com/vc7k8jhtvc-netizen/shadowrocket-rule/main/scripts/x-experimental-request.js

# 响应阶段：若该主机能成功解密，再复用稳定版时间线广告清理作为第二层兜底
x.experimental.response = type=http-response,pattern=^https:\/\/api\.twitter\.com\/(?:i\/api\/)?graphql\/,requires-body=1,max-size=4194304,binary-body-mode=1,timeout=8,script-path=https://raw.githubusercontent.com/vc7k8jhtvc-netizen/shadowrocket-rule/main/scripts/x-enhance.js

[MITM]
# 高风险实验项：iOS 原生 X 可能对该主机启用证书绑定；失败时停用本模块即可恢复
hostname = %APPEND% api.twitter.com
