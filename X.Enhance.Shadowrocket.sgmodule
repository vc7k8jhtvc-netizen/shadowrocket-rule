#!name=X Enhance (Shadowrocket)
#!desc=X/Twitter 去广告增强：拦截明确广告域名，并清理可解密 GraphQL/Timeline 响应中的 Promoted/Sponsored 条目；保守 MITM，明确避开 api.twitter.com
#!author=vc7k8jhtvc-netizen
#!homepage=https://github.com/vc7k8jhtvc-netizen/shadowrocket-rule
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Twitter.png

[Rule]
# 仅阻断名称和用途明确的广告端点；不默认屏蔽 scribe/p/analytics/syndication，降低功能误伤
DOMAIN,ads-api.twitter.com,REJECT
DOMAIN,ads-bidder-api.twitter.com,REJECT
DOMAIN-SUFFIX,ads-twitter.com,REJECT
DOMAIN,ads.twitter.com,REJECT
DOMAIN,static-ads.twitter.com,REJECT

[Script]
# 仅处理明确列出的可解密主机；pattern 故意不匹配 api.twitter.com
x.timeline.response = type=http-response,pattern=^https:\/\/(?:(?:www\.)?x\.com|api\.x\.com|(?:www\.|mobile\.)?twitter\.com|albtls\.t\.co)\/(?:i\/)?(?:api\/)?(?:graphql\/|2\/timeline\/),requires-body=1,max-size=4194304,script-path=https://raw.githubusercontent.com/vc7k8jhtvc-netizen/shadowrocket-rule/main/scripts/x-enhance.js

[MITM]
# iOS 原生 X 的 api.twitter.com 可能存在证书绑定；不要在此追加该主机
hostname = %APPEND% x.com, www.x.com, api.x.com, twitter.com, www.twitter.com, mobile.twitter.com, albtls.t.co
